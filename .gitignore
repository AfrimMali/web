# Build output — regenerated by render.py, published by Actions.
dist/

# Python
__pycache__/
*.py[cod]

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Credentials. This repo is public, so an accidental commit is permanent and
# cannot be taken back by deleting the file afterwards - the object stays in
# history. None of these belong here; the patterns are the safety net.
.env
.env.*
worker/.dev.vars
# wrangler's local cache. Holds the Cloudflare account id and the account name,
# which is the owner's email address - no credentials, but nothing that belongs
# in a public repo either.
worker/.wrangler/
auth.json
secrets*
*.pem
*.key
*.pfx
